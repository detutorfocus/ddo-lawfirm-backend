# ============================================================
# D.D. ONIETAN (SAN) & CO. — ENVIRONMENT VARIABLES
# Copy this file to .env.local for local development
# NEVER commit .env.local to version control
# ============================================================

# ── DATABASE ───────────────────────────────────────────────
# For Neon (https://neon.tech), copy the "Pooled connection" string from
# your dashboard EXACTLY as shown, then add ?sslmode=require if it's not
# already there. Neon REQUIRES SSL — connections fail without it.
#
# Correct Neon example:
# DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
#
# If Neon still shows "Can't reach database server":
#   1. Open your Neon dashboard — confirm the project/branch is not "Idle"
#      (free tier auto-suspends after inactivity; the first request wakes
#      it up but can take 5-10 seconds and occasionally times out once —
#      just retry the command)
#   2. Confirm you copied the POOLED connection string (has "-pooler" in
#      the hostname), not the direct one, for serverless/Prisma use
#   3. Confirm ?sslmode=require is present at the end of the URL
#   4. Check Windows Firewall / antivirus isn't blocking outbound :5432
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/onietan_lawfirm"

# ── NEXT.JS ────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-minimum-32-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-token-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# ── AWS S3 — Document Storage ──────────────────────────────
AWS_REGION="eu-west-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_BUCKET_NAME="onietan-law-documents"
AWS_S3_BUCKET_PUBLIC="onietan-law-public"
AWS_CLOUDFRONT_URL="https://your-cloudfront-domain.cloudfront.net"

# ── RESEND — Email Service ─────────────────────────────────
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="D.D. Onietan & Co. <noreply@ddonietanandco.com>"
EMAIL_REPLY_TO="info@ddonietanandco.com"

# ── REDIS — Caching & Session Store ───────────────────────
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD="your-redis-password"

# ── FIRM DETAILS ───────────────────────────────────────────
FIRM_NAME="D.D. Onietan (SAN) & Co."
FIRM_EMAIL="info@ddonietanandco.com"
FIRM_PHONE="+234 803 XXX XXXX"
FIRM_ADDRESS="Plot 14B, Adetokunbo Ademola Crescent, Wuse II, Abuja, FCT, Nigeria"

# ── SECURITY ───────────────────────────────────────────────
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
SESSION_MAX_AGE_DAYS=7
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ── FEATURE FLAGS ──────────────────────────────────────────
ENABLE_2FA=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_AUDIT_LOGS=true
ENABLE_RATE_LIMITING=true

# ── PRODUCTION OVERRIDES (Vercel/Railway) ─────────────────
# DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"
# NEXTAUTH_URL="https://api.ddonietanandco.com"
