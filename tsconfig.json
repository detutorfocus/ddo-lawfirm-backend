{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*":          ["./src/*"],
      "@/styles/*":   ["./styles/*"],
      "@/pages/*":    ["./pages/*"],
      "@/public/*":   ["./public/*"],
      "@/hooks/*":    ["./src/hooks/*"],
      "@/lib/*":      ["./src/lib/*"],
      "@/types":      ["./src/types/index"],
      "@/types/*":    ["./src/types/*"],
      "@/utils/*":    ["./src/utils/*"],
      "@/services/*": ["./src/services/*"],
      "@/components/*": ["./src/components/*"],
      "@/server/*":   ["./src/server/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
